{
  "name": "pi-taskwatcher",
  "version": "0.5.0",
  "description": "Progress chips for background tasks + auto-detached bash + hung-tool watchdog + one-shot wake-ups",
  "license": "MIT",
  "keywords": [
    "pi",
    "pi-extension",
    "pi-package",
    "progress",
    "status",
    "tasks"
  ],
  "pi": {
    "extensions": [
      "./taskwatcher.ts",
      "./autobg.ts",
      "./wake.ts"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codelllc09/pi-taskwatcher.git"
  },
  "homepage": "https://github.com/codelllc09/pi-taskwatcher#readme",
  "bugs": "https://github.com/codelllc09/pi-taskwatcher/issues",
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "typebox": "*"
  },
  "scripts": {
    "test": "node tests/test-extension.mjs && node tests/test-hardening.mjs && node tests/test-e2e.mjs && node tests/test-isolation.mjs && node tests/test-autobg.mjs && node tests/test-stuck-enolog.mjs && node tests/test-wake.mjs"
  },
  "files": [
    "taskwatcher.ts",
    "autobg.ts",
    "wake.ts",
    "scripts/",
    "!scripts/__pycache__",
    "docs/",
    "tests/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module"
}